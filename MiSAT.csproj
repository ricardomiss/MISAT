<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>MISAT</Title>
    <PackageProjectUrl>https://github.com/ricardomiss/MISAT</PackageProjectUrl>
    <Description>Librería para uso de los servicios del SAT</Description>
    <PackAsTool>False</PackAsTool>
    <VersionPrefix>1.1.1</VersionPrefix>
    <Authors>Ricardo Miss</Authors>
    <RepositoryUrl>https://github.com/ricardomiss/MISAT</RepositoryUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
